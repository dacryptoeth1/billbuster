GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional: model for retries, with its own rate limit (default gemini-3.1-flash-lite)
GEMINI_FALLBACK_MODEL=
# Voice practice (ElevenLabs agent "Pat")
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# PayPal sandbox test payments. Sandbox credentials only; other hosts are refused.
# `npm run paypal:check` reads these from .env; the app reads .env or .env.local.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
